# ============================================================
# Console Conquest — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ──────────────────────────────────────────────
# SQLite (development / single-server event deployment)
DATABASE_URL="file:./prisma/dev.db"

# PostgreSQL (production / multi-instance deployment)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/console_conquest?schema=public"

# ── Authentication ─────────────────────────────────────────
# REQUIRED: Random secret used to sign admin session cookies.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="CHANGE_THIS_TO_A_RANDOM_32_PLUS_CHAR_SECRET"

# Admin credentials (used by seed.ts — NOT a production bypass)
ADMIN_USERNAME="admin"
# This hash is for password "kombat2026!" — change in production via admin panel
ADMIN_PASSWORD_HASH="$2a$10$wW9r3Fv2Pq9fP2k7M9N4sOZgR7nE9.iP4y8E9R1r6cZt0bFkUeG2a"

# ── App URL (required for absolute URL generation) ─────────
NEXTAUTH_URL="http://localhost:3000"

# ── Event Configuration (public, not sensitive) ────────────
# These are defaults only — live values are stored in the database.
NEXT_PUBLIC_EVENT_NAME="Console Conquest"
NEXT_PUBLIC_GAME_NAME="Mortal Kombat 11"
NEXT_PUBLIC_DEFAULT_MAX_SLOTS=128
NEXT_PUBLIC_EVENT_DATE="2026-09-29T09:00:00+05:30"
NEXT_PUBLIC_EVENT_VENUE="Room No. 340, AISSMS COE Campus"

# ── Email (optional — for password reset / confirmation) ───
# EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="Console Conquest <noreply@example.com>"
